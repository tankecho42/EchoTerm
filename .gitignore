.build/
.swiftpm/
dist/
DerivedData/
.DS_Store
*.xcuserstate

# Local Python environments and generated bytecode
.venv/
__pycache__/
*.py[cod]

# Local credentials (the app stores API keys in macOS Keychain)
.env
.env.*
!.env.example
*.pem
*.p12
*.key

# Reproducible promo caches and platform-specific helper binaries
promo/**/previews/
promo/**/assets/type/
promo/**/source/type/
promo/**/source/text-render
promo/**/source/ocr-check
promo/**/source/*.wav
promo/**/assets/echo-60fps.json
promo/source/demo-audit.jsonl
promo/source/demo-port.txt

# Keep the latest approved Chinese and English films, not intermediate exports
promo/**/output/*.mp4
!promo/v8/output/EchoTerm-Promo-v8-46s.mp4
!promo/v10-en/output/EchoTerm-Promo-English-v10-46s.mp4
